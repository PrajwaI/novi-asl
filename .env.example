# Verified against Magnitude 0.2.17 on this installation. Recheck after upgrades.
MAGNITUDE_BASE_URL=http://127.0.0.1:10100/inference/v1
MAGNITUDE_MODEL=lfm3-1.7b:gguf:q4-qat
# Local loopback needed no key. For a remote server, set its network access key.
MAGNITUDE_API_KEY=
MAGNITUDE_STREAM=true
MAGNITUDE_REASONING_EFFORT=none
MAGNITUDE_TIMEOUT_MS=240000
PORT=8000
HOST=127.0.0.1
